PORT=5000
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/smart_life_admin

JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=30d

# SMS via Twilio. Leave SMS_PROVIDER=mock (or blank) to run in mock/dev mode —
# reminders will be logged to the console instead of sent, so the app never crashes
# without an SMS account. Set SMS_PROVIDER=twilio and fill in the three values below
# to actually deliver alarm/reminder SMS to the user's phone number.
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM_NUMBER=

# Email (SMTP via Nodemailer). Leave blank to run in mock/dev mode.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Smart Life Admin <no-reply@smartlifeadmin.app>

# Web Push (reminders reach the phone even when the app is closed).
# Generate keys with:  npm run vapid   -- then paste the three lines here. Leave blank to disable push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
